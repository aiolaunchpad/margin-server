# Copy into your host's environment settings (Render/Railway/Fly dashboard). Never commit real values.

# ---- required ----
# Your OpenAI key (set as a secret in the host dashboard)
OPENAI_API_KEY=
# Long random string that signs install tokens, e.g. output of: openssl rand -hex 32  (keep it stable)
TOKEN_SECRET=

# ---- recommended ----
NODE_ENV=production
# Stripe Payment Link for Pro, e.g. https://buy.stripe.com/xxxx (the install id is appended automatically)
CHECKOUT_URL=
# Your Chrome Web Store extension id (32 letters a-p). Empty = accept any chrome-extension:// origin
ALLOWED_EXTENSION_IDS=
# Where margin.sqlite lives — mount a persistent disk/volume here
DATA_DIR=/data

# ---- optional ----
MODEL=gpt-4o-mini
# e.g. gpt-4o for Double-Check / Explain; ESCALATE_FOR = pro | all | none
ESCALATION_MODEL=
ESCALATE_FOR=pro
FREE_DAILY_LIMIT=5
# 0 = unlimited; set e.g. 300 as a fair-use cap
PRO_DAILY_LIMIT=0
# high | low | auto  (vision detail; high is most accurate)
IMAGE_DETAIL=high
RATE_LIMIT_PER_MINUTE=30
REGISTER_PER_HOUR=20
# Enables POST /v1/admin/plan (manual Pro grants)
ADMIN_TOKEN=
# Enables POST /v1/stripe/webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Stripe customer-portal link shown to Pro users
MANAGE_BILLING_URL=
